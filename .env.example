# ==========================================
# Variables de Entorno - Proyecto LACTAR
# ==========================================
# Duplica este archivo como .env.local y completa los valores correspondientes
# provistos por Supabase (Settings -> API)

# URL del proyecto en Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (Anon Key - segura para el frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave de servicio / Admin (Service Role Key - opcional para endpoints de backend sin restricciones RLS)
# ATENCIÓN: NUNCA exponer esta clave con el prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
